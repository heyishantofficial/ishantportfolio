# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
*.local
.env
.env.*
.env.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Runtime site settings written by the server (repo root only —
# an unanchored "data" would also ignore src/data/)
/data/

# Master Sync snapshots. These are runtime state, not source.
# Committing one bakes it into the image, so an empty DATA_DIR would
# resurrect it on every redeploy and roll the live site backwards.
/public/master-snapshot.json
/dist/master-snapshot.json
/src/data/masterSnapshot.json
